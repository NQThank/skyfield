{
  "name": "eid-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "host": "vite --host",
    "lint": "eslint src --max-warnings=0",
    "types": "tsc --project tsconfig.json --noEmit",
    "prepare": "husky"
